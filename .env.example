# Copy to .env on the server and fill in the values. Never commit .env.

# "development" skips Google login (uses TS_USER_EMAIL) and allows a default SECRET_KEY.
# Anything else is production: SECRET_KEY is required and cookies are HTTPS-only.
APP_ENV=production

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Google OAuth client (redirect URI: https://explore.ivrit.ai/login/authorized)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SQLITE_PATH=explore.sqlite

# Analytics (optional)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
DISABLE_ANALYTICS=false

# Development only
TS_USER_EMAIL=
