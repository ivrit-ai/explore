# Copy to .env and fill in the values. Never commit .env.
# On the hosting platform these come from its environment settings instead.

# "development" bypasses sign-in (uses TS_USER_EMAIL). Anything else is
# production: identity comes from the platform's signed cookie.
APP_ENV=production

# Hostnames whose identity tokens are accepted (needed for a custom domain;
# defaults to the request host).
EXPLORE_AUTH_AUDIENCES=

# Index: auto (postgres when DATABASE_URL is set) | sqlite | postgres
EXPLORE_INDEX_BACKEND=auto
DATABASE_URL=
DATABASE_URL_DIRECT=
SQLITE_PATH=explore.sqlite

# Audio: auto (s3 when a bucket is set) | local | s3
EXPLORE_AUDIO_SOURCE=auto
EXPLORE_S3_BUCKET=
EXPLORE_S3_PREFIX=audio
EXPLORE_S3_REGION=

# Analytics (optional)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
DISABLE_ANALYTICS=false

# Development only
TS_USER_EMAIL=
